# Run `uv run python scripts/configure.py` to create a private .env with fresh secrets.
# Development HTTP only. Set secure cookies true when serving through HTTPS.
POSTGRES_PASSWORD='replace-with-a-long-random-value'
STUDIO_OWNER_PASSWORD_HASH='replace-with-an-argon2id-hash'
STUDIO_ENV=production
STUDIO_ALLOWED_ORIGINS=http://localhost:8001,http://localhost:5174,http://127.0.0.1:8001,http://127.0.0.1:5174
STUDIO_SECURE_COOKIES=false
STUDIO_MEDIA_ROOT=./var/media
STUDIO_FRONTEND_DIST=./frontend/dist
# For local Python processes. Compose overrides this to its internal db service.
DATABASE_URL=postgresql+psycopg://studio:replace-with-a-long-random-value@localhost:5433/studio
# Optional generation providers. No key is needed to edit uploads or export MP4.
OPENAI_API_KEY=''
RUNWAY_API_KEY=''
ELEVENLABS_API_KEY=''
STUDIO_STORY_MODEL=gpt-4.1-mini
STUDIO_IMAGE_MODEL=gpt-image-1
STUDIO_SPEECH_MODEL=gpt-4o-mini-tts
STUDIO_VIDEO_MODEL=gen4.5
STUDIO_MUSIC_MODEL=music_v1
